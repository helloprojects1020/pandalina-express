# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase project URL (found in: Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (found in: Project Settings → API → Project API keys)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local dev only: which restaurant slug to load (defaults to "pandalina" if unset)
VITE_RESTAURANT_SLUG=your-restaurant-slug
